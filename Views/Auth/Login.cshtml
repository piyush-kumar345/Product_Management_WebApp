@using Product_Management_WebApp.Dto
@model UserDto
<div>@ViewBag.SuccessMessage</div>
<div>@ViewBag.ErrorMessage</div>
<form class="container d-flex justify-content-center align-items-center" style=" min-height: 100vh" asp-action="LoginUser"> 
    <div class="card p-4 shadow" style="width : 100%; max-width:400px;">
        <h3 class="text-center mb-4">Login</h3>
    <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input type="email" class="form-control" id="email"  name="Email" asp-action="Email" placeholder="Enter your email">
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name ="Password" asp-action="Password" placeholder="Enter your password">
    </div>

    <button type="submit" class="btn btn-primary w-100">Login</button>
    </div>
</form> 
<br/>
New User<a asp-action="Register"> Register Here... </a>