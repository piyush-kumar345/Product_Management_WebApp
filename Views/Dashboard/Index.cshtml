@using Product_Management_WebApp.Dto
@model List<ProductDto>

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="status-message">@ViewBag.SuccessMessage</div>

<div class="container mt-4">

    <!-- Add Product Button -->
    <div class="mb-4">
        <a class="btn btn-primary btn-add-glow" asp-action="ProductForm">
            + Add Product
        </a>
    </div>

    <!-- Product Table -->
    <div class="table-responsive glass-table-card">
        <table class="table table-bordered table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Product Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Colour</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.ProductName</td>
                            <td>@product.Description</td>
                            <td>💲@product.Price</td>
                            <td>@product.Color</td>
                            <td>
                                <a asp-action="UpdateProductForm" asp-route-id="@product.Id" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="DeleteProduct" asp-route-ProductId="@product.Id" class="btn btn-secondary">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-secondary">No Product Are Avilable </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>