@using Product_Management_WebApp.Dto
@model List<ProductDto>



<div class="container mt-4">

    <!-- Add Product Button -->
    <div class="mb-3">
        <a class="btn btn-primary" asp-action="ProductForm">
            + Add Product
        </a>
    </div>

    <!-- Product Table -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Product Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Colour</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.ProductName</td>
                            <td>@product.Description</td>
                            <td>@product.Price</td>
                            <td>£@product.Color</td>
                            <td>
                                <button class="btn btn-warning btn-sm">Edit</button>
                                <a asp-action="DeleteProduct" asp-route-ProductId="@product.Id" class="btn btn-secondary">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>No Product Are Avilable </tr>
                }
                </tbody>    
        </table>
    </div>

</div>