@using Product_Management_WebApp.Dto
@model ProductDto
<div>@ViewBag.ErrorMessage</div>

    <form class="container mt-4" asp-action="CreateProduct">
       
        <div class="card p-4 shadow" style="max-width:600px; margin :auto">
             <h3 class="text-center mb-4">Add New Product</h3>
            <!-- Product Name -->
            <div class="mb-3">
                <label for="productName" class="form-label">Product Name</label>
                <input type="text" class="form-control" id="productName" name ="ProductName" asp-for="ProductName"
                       placeholder="Enter product name">
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea class="form-control" id="description" rows="3" name="Description" asp-for="Description "
                          placeholder="Enter product description"></textarea>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input type="number" class="form-control" id="price" name="Price" asp-for="Price"
                       placeholder="Enter product price">
            </div>

            <!-- Colour -->
            <div class="mb-3">
                <label for="colour" class="form-label">Colour</label>
                <input type="text" class="form-control" id="colour" name="color" asp-for="Color"
                       placeholder="Enter product colour">
            </div>

            <!-- Buttons -->
            <button type="submit" class="btn btn-success">Save Product</button>
            <br />
            <button asp-action="Reset" type="reset" class="btn btn-secondary">Reset</button>
             
        </div>  
    </form>